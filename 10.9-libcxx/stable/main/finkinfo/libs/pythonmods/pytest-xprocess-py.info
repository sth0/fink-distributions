Info2: <<
Package: pytest-xprocess-py%type_pkg[python]
Version: 1.0.2
Revision: 1
Description: Plugin for managing processes in test runs
License: BSD
# Free to update and take over
Maintainer: Hanspeter Niederstrasser <nieder@users.sourceforge.net>
Type: python (3.8 3.9 3.10)
Depends: <<
	python%type_pkg[python],
	psutil-py%type_pkg[python],
	pytest-py%type_pkg[python] (>= 2.8.0)
<<
BuildDepends: <<
	bootstrap-modules-py%type_pkg[python],
	setuptools-tng-py%type_pkg[python] (>= 45.0),
	setuptools-scm-py%type_pkg[python] (>= 6.2.3)
<<
Source: https://files.pythonhosted.org/packages/source/p/pytest-xprocess/pytest-xprocess-%v.tar.gz
Source-Checksum: SHA256(15e270637586eabc56755ee5fcc81c48bdb46ba7ef7c0d5b1b64302d080cc60f)
CompileScript: <<
	PYTHONPATH=%p/share/bootstrap-modules-python%type_pkg[python] %p/bin/python%type_raw[python] -m build --wheel --no-isolation --skip-dependency-check
<<
InfoTest: <<
	TestDepends: <<
		coverage-py%type_pkg[python]
	<<
	TestScript: <<
		# upstream known test failures #162
		PYTHONPATH=%b %p/bin/python%type_raw[python] -B -m pytest -p no:randomly -vv -k 'not(test_interruption_does_not_cleanup or test_functional_work_flow)' || exit 2
	<<
<<
InstallScript: <<
	PYTHONPATH=%p/share/bootstrap-modules-python%type_pkg[python] %p/bin/python%type_raw[python] -m installer --destdir %d dist/*.whl
<<
DocFiles: LICENSE README.rst
Homepage: https://github.com/pytest-dev/pytest-xprocess
DescDetail: <<
A pytest plugin for managing external processes across test runs.
<<
<<
