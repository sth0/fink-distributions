Depends: python%type_pkg[python]
BuildDepends: <<
	bootstrap-modules-py%type_pkg[python] (>= 20260125),
	hatchling-py%type_pkg[python] (>= 1.6)
<<
Recommends: twisted-py%type_pkg[python]

Maintainer: Derek Homeier <dhomeie@gwdg.de>
License: OSI-Approved
Homepage: https://github.com/twisted/incremental/
Source: https://files.pythonhosted.org/packages/source/i/incremental/incremental-%v.tar.gz
Source-Checksum: SHA256(87d3480dbb083c1d736222511a8cf380012a8176c2456d01ef483242abbbcf8c)

CompileScript: <<
	PYTHONPATH=%p/share/bootstrap-modules-python%type_pkg[python] %p/bin/python%type_raw[python] -m build --wheel --no-isolation --skip-dependency-check
<<

InstallScript: <<
	#!/bin/sh -ev
	PYTHONPATH=%p/share/bootstrap-modules-python%type_pkg[python] %p/bin/python%type_raw[python] -m installer --destdir %d dist/*.whl
	for i in incremental ; do
		mv %i/bin/$i %i/bin/$i-py%type_raw[python]
	done
<<
PostInstScript: <<
	update-alternatives --verbose --install %p/bin/incremental incremental %p/bin/incremental-py%type_raw[python] %type_pkg[python]
<<
PreRmScript: <<
	if [ $1 != "upgrade" ]; then
		update-alternatives --verbose --remove incremental %p/bin/incremental-py%type_raw[python]
	fi
<<

InfoTest: <<
#        twisted-py%type_pkg[python]
    TestDepends: <<
        pytest-py%type_pkg[python],
        click-py%type_pkg[python],
        constantly-py%type_pkg[python]
    <<
# Circular deps: only run tests if twisted is already installed. 
    TestScript: <<
        #!/bin/sh -ev
        if [ -f %p/lib/python%type_raw[python]/site-packages/twisted/__init__.py ]; then
            LANG=en_US.UTF-8 PYTHONPATH=%b/build/lib %p/bin/python%type_raw[python] -Bm pytest || exit 2
        fi
    <<
    TestSuiteSize: small
<<

